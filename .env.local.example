# ============================================================
# B-E Waterwell Services — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# WPGraphQL endpoint — set this when your xCloud WordPress
# instance is live and WPGraphQL is activated.
# Example: https://your-xcloud-domain.com/graphql
NEXT_PUBLIC_WPGRAPHQL_ENDPOINT=

# Site URL (used for canonical URLs and OG tags)
NEXT_PUBLIC_SITE_URL=https://bewaterwells.com

# Contact form recipient (if using a serverless email handler)
CONTACT_FORM_EMAIL=info@bewaterwells.com
